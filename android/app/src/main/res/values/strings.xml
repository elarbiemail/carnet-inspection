<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Carnet d\'Inspection</string>

    <!-- Adresse de l'application déployée sur GitHub Pages (pour mémoire). Android
         n'accepte PAS de référence @string pour l'adresse de lancement, le domaine
         et le fournisseur de fichiers : ces valeurs sont écrites en clair dans
         AndroidManifest.xml — à modifier là aussi si l'adresse change. -->
    <string name="launch_url">https://elarbiemail.github.io/carnet-inspection/</string>
    <string name="host_name">elarbiemail.github.io</string>
    <string name="path_prefix">/carnet-inspection</string>

    <string name="provider_authority">net.fm6education.carnetinspection.fileprovider</string>

    <!-- Digital Asset Links : à faire vérifier en publiant le fichier
         assetlinks.json fourni (voir GUIDE-APK.md) à la racine de
         https://elarbiemail.github.io/.well-known/assetlinks.json -->
    <string name="asset_statements">
        [{
          \"relation\": [\"delegate_permission/common.handle_all_urls\"],
          \"target\": {\"namespace\": \"web\", \"site\": \"https://elarbiemail.github.io\"}
        }]
    </string>
</resources>
